<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/margin_15"
    android:layout_marginStart="@dimen/margin_10dp"
    android:layout_marginEnd="@dimen/margin_10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="@dimen/padding_2"
    android:background="@drawable/circle_white"
    android:layout_marginTop="@dimen/padding_5"
    android:layout_marginBottom="@dimen/padding_5">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:id="@+id/pic"
            android:src="@drawable/user_avatar"/>
        <LinearLayout
            android:layout_marginTop="@dimen/padding_5"
            android:layout_marginStart="@dimen/margin_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_marginStart="@dimen/padding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/margin_15"
                android:textColor="#2C2A2A"
                android:id="@+id/name"/>
            <LinearLayout
                android:layout_marginStart="@dimen/padding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:gravity="start"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/padding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppin_regular"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="#4B4B4B"
                    android:id="@+id/about"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/padding_5"
                android:layout_gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_marginEnd="@dimen/margin_7"
                    android:id="@+id/cancel"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/text_13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel_caps"/>
                <TextView
                    android:layout_marginStart="@dimen/margin_7"
                    android:id="@+id/accept"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/text_13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/pink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accept_caps"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>