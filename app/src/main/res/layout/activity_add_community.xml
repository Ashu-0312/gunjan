<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".activities.AddCommunityActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/light_white"
        android:paddingBottom="@dimen/margin_20dp"
        android:paddingTop="@dimen/margin_10dp"
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_marginTop="@dimen/margin_15"
            android:id="@+id/back"
            android:layout_marginStart="@dimen/margin_15"
            android:layout_width="@dimen/margin_20dp"
            android:layout_height="@dimen/margin_20dp"
            android:src="@drawable/back"
            tools:ignore="RtlCompat" />
        <TextView
            android:textSize="@dimen/text_17sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_your_community"
            android:textColor="@color/pink"
            android:gravity="center"
            android:layout_marginTop="@dimen/margin_10dp"
            android:fontFamily="@font/popinbold"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@+id/header">
        <LinearLayout
            android:layout_marginTop="50dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/choosePic"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <de.hdodenhof.circleimageview.CircleImageView
                    app:civ_border_width="@dimen/padding_2"
                    app:civ_border_color="@color/pink"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/user_avatar"/>
                <ImageView
                    android:layout_width="@dimen/margin_25"
                    android:layout_height="@dimen/margin_25"
                    android:src="@drawable/add"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="65dp"/>
            </RelativeLayout>
            <TextView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/pink"
                android:text="@string/add_logo"/>
        </LinearLayout>
        <LinearLayout
            android:elevation="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_15"
            android:layout_marginTop="@dimen/margin_40dp"
            android:layout_marginEnd="@dimen/margin_15"
            android:background="@drawable/edittext_bg"
            android:orientation="horizontal"
            android:padding="@dimen/padding_5">

            <EditText
                android:layout_weight="1"
                android:layout_marginTop="1dp"
                android:layout_gravity="center"
                android:id="@+id/community"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Enter Community Name"
                android:maxLines="1"
                android:maxLength="50"
                android:inputType="text"
                android:layout_marginStart="@dimen/margin_10dp"
                android:paddingTop="@dimen/text_13sp"
                android:paddingRight="@dimen/margin_10dp"
                android:paddingBottom="@dimen/text_13sp"
                android:fontFamily="@font/poppins_light"
                android:textColor="@color/txt_color"
                android:textColorHint="@color/txt_color"
                android:textSize="@dimen/text_13sp"
                tools:ignore="RtlCompat" />
        </LinearLayout>
        <LinearLayout
            android:elevation="3dp"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_15"
            android:layout_marginTop="@dimen/margin_15"
            android:layout_marginEnd="@dimen/margin_15"
            android:background="@drawable/edittext_bg"
            android:orientation="horizontal">

                <EditText
                    android:layout_gravity="top"
                    android:gravity="top"
                    android:id="@+id/query"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/tell_about_your_community"
                    android:maxLength="200"
                    android:inputType="textMultiLine"
                    android:layout_marginStart="7dp"
                    android:padding="@dimen/margin_7"
                    android:fontFamily="@font/poppin_regular"
                    android:textColor="@color/txt_color"
                    android:textColorHint="@color/txt_color"
                    android:textSize="@dimen/text_13sp"
                    tools:ignore="RtlCompat" />
        </LinearLayout>
        <LinearLayout
            android:elevation="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_15"
            android:layout_marginTop="@dimen/margin_15"
            android:layout_marginEnd="@dimen/margin_15"
            android:background="@drawable/edittext_bg"
            android:orientation="horizontal"
            android:padding="@dimen/padding_5">
            <Spinner
                android:layout_marginTop="@dimen/padding_5"
                android:layout_marginBottom="@dimen/padding_5"
                android:id="@+id/categorySpinner"
                android:backgroundTint="@color/pink"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/Submit"
            android:elevation="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_40dp"
            android:layout_marginTop="120dp"
            android:layout_marginEnd="@dimen/margin_40dp"
            android:layout_marginBottom="@dimen/margin_20dp"
            android:background="@drawable/button_bg"
            android:orientation="horizontal"
            android:padding="@dimen/padding_5">
            <TextView
                android:layout_marginTop="@dimen/padding_5"
                android:layout_marginBottom="@dimen/padding_5"
                android:layout_gravity="center"
                android:gravity="center"
                android:textSize="@dimen/text_18sp"
                android:fontFamily="@font/popinbold"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/submit"/>
        </LinearLayout>
    </LinearLayout>
    </RelativeLayout>
</ScrollView>
