<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/popup_window"
    android:elevation="1dp"
    android:layout_margin="@dimen/margin_15"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:paddingTop="@dimen/margin_10dp"

    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginTop="@dimen/margin_40dp"
    android:background="@drawable/circle_white"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <ImageView
        android:layout_marginTop="@dimen/margin_15"
        android:layout_marginEnd="@dimen/margin_15"
        android:layout_marginStart="@dimen/margin_15"
        android:layout_alignParentEnd="true"
        android:id="@+id/close"
        android:layout_width="@dimen/text_17sp"
        android:layout_height="@dimen/text_17sp"
        android:src="@drawable/cross_black"/>

    <LinearLayout
        android:layout_marginTop="@dimen/margin_40dp"
        android:paddingTop="@dimen/margin_20dp"
        android:paddingBottom="@dimen/margin_20dp"
        android:gravity="start"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/rl_header">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_below="@+id/header">
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_gravity="center"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:civ_border_color="@color/pink"
                app:civ_border_width="@dimen/padding_2"
                android:src="@drawable/user_avatar"/>
            <TextView
                android:gravity="center"
                android:layout_below="@id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/popinbold"
                android:textColor="@color/pink"
                android:textSize="@dimen/text_17sp"
                android:layout_marginTop="@dimen/text_30sp"
                android:layout_marginStart="@dimen/text_30sp"
                android:layout_marginEnd="@dimen/text_30sp"
                android:text="Bharat Yuva Shakti"/>
            <TextView
                android:id="@+id/txt"
                android:gravity="center"
                android:layout_below="@id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppin_regular"
                android:textColor="@color/black2"
                android:textSize="@dimen/text_13sp"
                android:layout_marginTop="@dimen/margin_20dp"
                android:layout_marginStart="@dimen/text_30sp"
                android:layout_marginEnd="@dimen/text_30sp"
                android:text="Bharat Yuva Shakti is not political youth union. and in this community members connected from all the region,religion,cred and beliefs.Through this community we are helping youth to raise their voice for good to great."/>
    </LinearLayout>
    </LinearLayout>
    </RelativeLayout>
</ScrollView>