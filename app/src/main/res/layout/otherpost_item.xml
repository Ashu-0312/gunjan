<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:layout_marginBottom="@dimen/padding_8"
    android:paddingBottom="@dimen/margin_10dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_marginTop="@dimen/padding_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_10dp"
        android:layout_marginEnd="@dimen/margin_10dp"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/user_profile"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/user_avatar"
            app:civ_border_color="@color/pink"
            app:civ_border_width="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppin_regular"
                android:id="@+id/name"
                android:textColor="@color/black3"
                android:textSize="@dimen/text_13sp" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_light"
                android:textColor="@color/black3"
                android:textSize="@dimen/text_12sp" />
        </LinearLayout>
        <LinearLayout
            android:visibility="gone"
            android:id="@+id/event_layout"
            android:layout_marginEnd="@dimen/padding_2"
            android:layout_marginStart="@dimen/margin_10dp"
            android:layout_marginBottom="@dimen/padding_2"
            android:elevation="@dimen/padding_2"
            android:background="@drawable/circle_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/margin_7">

            <ImageView
                android:layout_width="@dimen/margin_15"
                android:layout_height="@dimen/margin_15"
                android:src="@drawable/dob"/>
            <LinearLayout
                android:layout_marginStart="@dimen/padding_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/activity_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/popinbold"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="@color/pink"/>
                <TextView
                    android:id="@+id/activity_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppin_medium"
                    android:textSize="@dimen/text_size_11"
                    android:textColor="@color/pink"/>
                <TextView
                    android:id="@+id/activity_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppin_medium"
                    android:textSize="@dimen/margin_10dp"
                    android:textColor="@color/pink"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView

            android:layout_marginStart="@dimen/padding_5"
            android:id="@+id/menu"
            android:layout_width="@dimen/margin_20dp"
            android:layout_height="@dimen/margin_20dp"
            android:src="@drawable/dots" />
    </LinearLayout>

    <LinearLayout

        android:layout_marginBottom="@dimen/margin_10dp"
        android:id="@+id/txt_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_20dp"
            android:layout_marginTop="@dimen/margin_10dp"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:fontFamily="@font/poppins_light"
            android:maxLines="4"
            android:textSize="@dimen/text_13sp" />

        <TextView
            android:id="@+id/show_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_20dp"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:fontFamily="@font/poppin_medium"
            android:text="@string/showmore"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textSize="@dimen/text_13sp" />
    </LinearLayout>

    <RelativeLayout
        android:layout_marginStart="@dimen/margin_10dp"
        android:layout_marginEnd="@dimen/margin_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:minWidth="130dp"
            android:id="@+id/joined_event"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:elevation="1dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/total_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_10dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:fontFamily="@font/popinbold"
                android:gravity="center"
                android:text="@string/_0_users_joined"
                android:textColor="@color/blue"
                android:textSize="@dimen/margin_15" />
        </LinearLayout>

        <LinearLayout
            android:minWidth="130dp"
            android:id="@+id/join_event"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:elevation="1dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/join_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginEnd="@dimen/margin_10dp"
                android:fontFamily="@font/popinbold"
                android:gravity="center"
                android:text="@string/join_event"
                android:textColor="@color/blue"
                android:textSize="@dimen/margin_15" />
        </LinearLayout>

    </RelativeLayout>

    <ImageView
        android:visibility="gone"
        android:layout_marginTop="@dimen/margin_10dp"
        android:id="@+id/pic_layout"
        android:scaleType="fitXY"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:src="@drawable/logo"/>
    <FrameLayout
        android:layout_marginTop="@dimen/margin_10dp"
        android:visibility="gone"
        android:id="@+id/video_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <VideoView
            android:visibility="gone"
            android:layout_gravity="center"
            android:id="@+id/media_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <ImageView
            android:visibility="gone"
            android:layout_gravity="center"
            android:id="@+id/pause"
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            android:src="@drawable/pause"/>
        <ImageView
            android:visibility="gone"
            android:layout_gravity="center"
            android:id="@+id/play"
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            android:src="@drawable/play_24"/>

        <ProgressBar
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/progress_bar"/>

    </FrameLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/txt_color" />

    <LinearLayout
        android:layout_marginTop="@dimen/margin_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_15"
        android:layout_marginEnd="@dimen/margin_15"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_gravity="center"
            android:id="@+id/comment_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/margin_20dp"
                android:src="@drawable/message_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_5"
                android:fontFamily="@font/poppin_medium"
                android:id="@+id/total_comment"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/total_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/padding_3"
                android:fontFamily="@font/poppin_medium"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_12sp" />

            <ImageView
                android:layout_gravity="center"
                android:id="@+id/like"
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/text_18sp"
                android:layout_marginStart="@dimen/padding_3"
                android:src="@drawable/like" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/padding_3"
                android:fontFamily="@font/poppin_medium"
                android:gravity="center"
                android:text="@string/vote"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_12sp" />

            <ImageView
                android:layout_marginTop="1dp"
                android:id="@+id/dislike"
                android:layout_width="19dp"
                android:layout_height="@dimen/text_17sp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/padding_3"
                android:src="@drawable/dislike" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/padding_3"
                android:fontFamily="@font/poppin_medium"
                android:gravity="center"
                android:text="0"
                android:id="@+id/total_dislike"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:layout_gravity="center"
            android:id="@+id/share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/margin_20dp"
                android:src="@drawable/share" />

            <TextView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_3"
                android:fontFamily="@font/poppin_medium"
                android:text="@string/share"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_12sp" />
        </LinearLayout>
        <ImageView
            android:layout_weight="1"
            android:layout_width="@dimen/text_17sp"
            android:layout_height="@dimen/text_17sp"
            android:src="@drawable/reward"
            android:id="@+id/reward"
            android:layout_marginStart="@dimen/margin_10dp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/comment_layout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_10dp"
        android:layout_marginTop="@dimen/margin_15"
        android:layout_marginEnd="@dimen/margin_10dp"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            android:layout_gravity="center"
            android:src="@drawable/user_avatar"
            app:civ_border_color="@color/txt_color"
            app:civ_border_width="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_10dp"
            android:layout_marginTop="@dimen/padding_2"
            android:layout_marginEnd="@dimen/padding_2"
            android:layout_marginBottom="@dimen/padding_3"
            android:background="@drawable/edittext_bg"
            android:elevation="1dp"
            android:orientation="horizontal"
            android:padding="@dimen/padding_5">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/poppins_light"
                android:hint="Write a comment..."
                android:paddingTop="@dimen/padding_5"
                android:paddingRight="@dimen/margin_10dp"
                android:paddingBottom="@dimen/padding_5"
                android:textColor="@color/txt_color"
                android:textColorHint="@color/txt_color"
                android:textSize="@dimen/text_13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>