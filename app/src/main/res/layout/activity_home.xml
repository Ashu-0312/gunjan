<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorlayout"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <ImageView
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:src="@drawable/logo"
        android:elevation="1dp"
        android:layout_centerHorizontal="true"
        android:id="@+id/logo"/>
    <ImageView
        android:layout_marginTop="@dimen/margin_25"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/margin_20dp"
        android:layout_marginStart="@dimen/margin_20dp"
        android:elevation="1dp"
        android:id="@+id/notification"
        android:layout_centerHorizontal="true"
        android:layout_width="@dimen/margin_25"
        android:layout_height="@dimen/margin_25"
        android:src="@drawable/notification"/>
    <FrameLayout
        android:layout_below="@id/logo"
        android:id="@+id/frame_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/bg"/>
    <ImageView
        android:elevation="1dp"
        android:id="@+id/addCommunity"
        android:layout_marginBottom="@dimen/margin_15"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/add_community"/>
    <LinearLayout
        android:weightSum="6"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:id="@+id/home"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/home_icon"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"
                android:src="@drawable/home_selected" />

            <TextView
                android:id="@+id/home_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/text_size_11"
                android:text="Home"
                android:textColor="@color/pink"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/member"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_weight="1.5">
            <ImageView
                android:id="@+id/member_icon"
                android:src="@drawable/member_not_selected"
                android:layout_width="27dp"
                android:layout_height="@dimen/margin_25"/>
            <TextView
                android:id="@+id/member_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/text_size_11"
                android:text="Members"
                android:textColor="@color/txt_color"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/text_12sp"
                android:textColor="@color/txt_color"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/messages"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_weight="1.5">
            <ImageView
                android:id="@+id/message_icon"
                android:src="@drawable/message_not_selected"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"/>
            <TextView
                android:id="@+id/message_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/text_size_11"
                android:text="Messages"
                android:textColor="@color/txt_color"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/account"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/account_icon"
                android:src="@drawable/profile_not_selected"
                android:layout_width="@dimen/margin_25"
                android:layout_height="@dimen/margin_25"/>
            <TextView
                android:id="@+id/account_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/text_size_11"
                android:text="Profile"
                android:textColor="@color/txt_color"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>