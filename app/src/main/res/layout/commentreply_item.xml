<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="@dimen/margin_10dp"
    android:layout_marginEnd="@dimen/margin_10dp"
    android:layout_marginBottom="@dimen/padding_5"
    android:layout_marginTop="@dimen/padding_5"
    android:orientation="horizontal">
    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_marginTop="@dimen/padding_5"
        android:id="@+id/user_pic"
        android:layout_width="45dp"
        app:civ_border_width="1dp"
        app:civ_border_color="@color/pink"
        android:layout_gravity="top"
        android:src="@drawable/user_avatar"
        android:layout_height="45dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/delete_comment"
            android:layout_gravity="start"
            android:gravity="center"
            android:padding="@dimen/margin_10dp"
            android:elevation="5dp"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_10dp"
            android:layout_marginEnd="@dimen/margin_10dp"
            android:layout_marginTop="@dimen/padding_2"
            android:layout_marginBottom="@dimen/padding_2"
            android:background="@drawable/left_chat_bg"
            android:layout_width="wrap_content"
            android:minWidth="100dp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_gravity="start"
                android:fontFamily="@font/poppin_medium"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12sp"
                android:textColor="@color/black"/>
            <TextView
                android:layout_gravity="start"
                android:fontFamily="@font/poppin_regular"
                android:id="@+id/comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12sp"
                android:textColor="@color/txt_color">
            </TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/margin_7"
            android:layout_marginStart="@dimen/margin_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/padding_3"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppin_medium"
                    android:gravity="center"
                    android:text="0"
                    android:id="@+id/total_like"
                    android:textColor="@color/pink"
                    android:textSize="@dimen/text_12sp" />

                <ImageView
                    android:id="@+id/like"
                    android:layout_width="@dimen/margin_20dp"
                    android:layout_height="@dimen/margin_20dp"
                    android:layout_marginStart="@dimen/padding_3"
                    android:src="@drawable/like" />

                <ImageView
                    android:id="@+id/dislike"
                    android:layout_width="@dimen/margin_20dp"
                    android:layout_height="@dimen/margin_20dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/padding_3"
                    android:src="@drawable/dislike" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/padding_3"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppin_medium"
                    android:gravity="center"
                    android:text="0"
                    android:id="@+id/total_dislike"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/text_12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>