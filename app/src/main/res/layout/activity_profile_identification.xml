<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".activities.ProfileIdentificationActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@color/light_white"
            android:paddingBottom="@dimen/margin_20dp"
            android:paddingTop="@dimen/margin_10dp"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_marginTop="@dimen/margin_15"
                android:id="@+id/back"
                android:layout_marginStart="@dimen/margin_15"
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/margin_20dp"
                android:src="@drawable/back"
                tools:ignore="RtlCompat" />
            <TextView
                android:textSize="@dimen/text_17sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_identification"
                android:textColor="@color/pink"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_10dp"
                android:fontFamily="@font/popinbold"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_below="@+id/header">
            <ImageView
                android:layout_marginTop="@dimen/margin_20dp"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:src="@drawable/logo"/>
            <TextView
                android:id="@+id/txt"
                android:gravity="center"
                android:layout_below="@id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppin_regular"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_13sp"
                android:layout_marginTop="@dimen/margin_40dp"
                android:layout_marginStart="@dimen/text_30sp"
                android:layout_marginEnd="@dimen/text_30sp"
                android:text="@string/upload_profile_photo_for"/>
            <TextView
                android:gravity="center"
                android:layout_below="@id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppin_regular"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_13sp"
                android:layout_marginStart="@dimen/text_30sp"
                android:layout_marginEnd="@dimen/text_30sp"
                android:text="@string/identification"/>
            <LinearLayout
                android:elevation="2dp"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_25"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="@dimen/margin_25"
                android:layout_marginBottom="@dimen/padding_5"
                android:background="@drawable/pink_border"
                android:orientation="horizontal">
                 <androidx.cardview.widget.CardView
                     android:layout_margin="1dp"
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     app:cardCornerRadius="@dimen/margin_15">
                     <LinearLayout
                         android:layout_gravity="center"
                         android:gravity="center"
                         android:layout_width="match_parent"
                         android:layout_height="match_parent"
                         android:orientation="vertical">
                     <RelativeLayout
                         android:layout_gravity="center"
                         android:id="@+id/choosePic"
                         android:layout_centerHorizontal="true"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content">
                         <de.hdodenhof.circleimageview.CircleImageView
                             app:civ_border_width="@dimen/padding_2"
                             app:civ_border_color="@color/pink"
                             android:layout_width="80dp"
                             android:layout_height="80dp"
                             android:src="@drawable/user_avatar"/>
                         <ImageView
                             android:layout_width="@dimen/margin_25"
                             android:layout_height="@dimen/margin_25"
                             android:src="@drawable/add"
                             android:layout_centerHorizontal="true"
                             android:layout_marginTop="65dp"/>
                     </RelativeLayout>
                     <TextView
                         android:layout_gravity="center"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:textSize="@dimen/text_12sp"
                         android:fontFamily="@font/poppins_semibold"
                         android:textColor="@color/pink"
                         android:text="@string/add_profile_photo"/>
                     </LinearLayout>
                     <ImageView
                         android:visibility="gone"
                         android:layout_width="match_parent"
                         android:layout_height="match_parent"
                         android:id="@+id/profilePic"
                         android:src="@drawable/user_avatar"
                         android:scaleType="fitXY"/>
                 </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/AddPhoto"
                android:elevation="1dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_40dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="@dimen/margin_40dp"
                android:layout_marginBottom="@dimen/padding_5"
                android:background="@drawable/button_bg"
                android:orientation="horizontal"
                android:padding="@dimen/padding_5">
                <TextView
                    android:layout_marginTop="@dimen/padding_5"
                    android:layout_marginBottom="@dimen/padding_5"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/text_18sp"
                    android:fontFamily="@font/popinbold"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_photo"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>