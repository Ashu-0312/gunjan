<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".activities.SocialProfileActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <ImageView
        android:layout_margin="@dimen/margin_15"
        android:layout_width="@dimen/margin_25"
        android:layout_height="@dimen/margin_25"
        android:src="@drawable/back_white"
        android:id="@+id/back"
        android:elevation="1dp"/>
<LinearLayout
    android:id="@+id/layout"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    android:background="@color/pink"
    android:orientation="vertical">
    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_marginTop="@dimen/margin_10dp"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:id="@+id/userPic"
        android:src="@drawable/user_avatar"
        app:civ_border_color="@color/white"
        app:civ_border_width="@dimen/padding_2"
        android:layout_gravity="center"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_10dp"
        android:layout_marginEnd="@dimen/margin_10dp"
        android:textColor="@color/white"
        android:textSize="@dimen/text_17sp"
        android:id="@+id/userName"
        android:fontFamily="@font/popinbold"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginTop="@dimen/margin_10dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_10dp"
        android:layout_marginEnd="@dimen/margin_10dp"
        android:textColor="@color/white"
        android:textSize="@dimen/text_17sp"
        android:id="@+id/userDesignation"
        android:fontFamily="@font/poppin_medium"
        android:layout_gravity="center"
        android:gravity="center"/>
</LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_15"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="@dimen/margin_15"
            android:layout_marginBottom="@dimen/padding_5"
            android:background="@drawable/pink_border"
            android:elevation="3dp"
            android:orientation="horizontal"
            android:padding="@dimen/padding_5">

            <ImageView
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/margin_20dp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_10dp"
                android:src="@drawable/youtube" />

            <TextView
                android:layout_marginStart="@dimen/margin_7"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13sp"
                android:textColor="@color/txt_color"
                android:text="https://www.youtube.com/"/>

            <TextView
                android:id="@+id/youtubeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/poppins_light"
                android:hint="@string/enter_name"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="@dimen/margin_10dp"
                android:paddingEnd="@dimen/padding_5"
                android:paddingBottom="@dimen/margin_10dp"
                android:textColor="@color/txt_color"
                android:textColorHint="@color/txt_color"
                android:textSize="@dimen/text_13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_15"
            android:layout_marginTop="@dimen/margin_15"
            android:layout_marginEnd="@dimen/margin_15"
            android:layout_marginBottom="@dimen/padding_5"
            android:background="@drawable/pink_border"
            android:elevation="3dp"
            android:orientation="horizontal"
            android:padding="@dimen/padding_5">

            <ImageView
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/margin_20dp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_10dp"
                android:src="@drawable/facebook" />

            <TextView
                android:layout_marginStart="@dimen/margin_7"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13sp"
                android:textColor="@color/txt_color"
                android:text="https://www.facebook.com/"/>

            <TextView
                android:id="@+id/fbName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/poppins_light"
                android:hint="@string/enter_name"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="@dimen/margin_10dp"
                android:paddingEnd="@dimen/padding_5"
                android:paddingBottom="@dimen/margin_10dp"
                android:textColor="@color/txt_color"
                android:textColorHint="@color/txt_color"
                android:textSize="@dimen/text_13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_15"
            android:layout_marginTop="@dimen/margin_15"
            android:layout_marginEnd="@dimen/margin_15"
            android:layout_marginBottom="@dimen/padding_5"
            android:background="@drawable/pink_border"
            android:elevation="3dp"
            android:orientation="horizontal"
            android:padding="@dimen/padding_5">

            <ImageView
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/margin_20dp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_10dp"
                android:src="@drawable/instagram" />

            <TextView
                android:layout_marginStart="@dimen/margin_7"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13sp"
                android:textColor="@color/txt_color"
                android:text="https://www.instagram.com/"/>

            <TextView
                android:id="@+id/instaName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/poppins_light"
                android:hint="@string/enter_name"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="@dimen/margin_10dp"
                android:paddingEnd="@dimen/padding_5"
                android:paddingBottom="@dimen/margin_10dp"
                android:textColor="@color/txt_color"
                android:textColorHint="@color/txt_color"
                android:textSize="@dimen/text_13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_15"
            android:layout_marginTop="@dimen/margin_15"
            android:layout_marginEnd="@dimen/margin_15"
            android:layout_marginBottom="@dimen/padding_5"
            android:background="@drawable/pink_border"
            android:elevation="3dp"
            android:orientation="horizontal"
            android:padding="@dimen/padding_5">

            <ImageView
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/margin_20dp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_10dp"
                android:src="@drawable/linkedin" />

            <TextView
                android:layout_marginStart="@dimen/margin_7"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_13sp"
                android:textColor="@color/txt_color"
                android:text="https://www.linkedin.com/"/>

            <TextView
                android:id="@+id/linkedInName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="7dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/poppins_light"
                android:hint="@string/enter_name"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="@dimen/margin_10dp"
                android:paddingEnd="@dimen/padding_5"
                android:paddingBottom="@dimen/margin_10dp"
                android:textColor="@color/txt_color"
                android:textColorHint="@color/txt_color"
                android:textSize="@dimen/text_13sp" />
        </LinearLayout>
    </LinearLayout>
    </RelativeLayout>
</ScrollView>