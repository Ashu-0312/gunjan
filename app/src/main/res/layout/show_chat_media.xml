<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popup_window"
    android:padding="@dimen/padding_5"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_margin="@dimen/text_30sp"
    android:layout_gravity="center"
    android:background="@drawable/circle_white"
    android:orientation="vertical">
    <androidx.cardview.widget.CardView
        android:layout_margin="1dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="@dimen/margin_20dp">
    <ImageView
        android:visibility="gone"
        android:scaleType="fitXY"
        android:id="@+id/image"
        android:layout_centerHorizontal="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/logo"/>
        <FrameLayout
            android:visibility="gone"
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <VideoView
                android:visibility="gone"
                android:layout_gravity="center"
                android:id="@+id/video_view_chat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ImageView
                android:visibility="gone"
                android:layout_gravity="center"
                android:id="@+id/pause"
                android:layout_width="@dimen/margin_40dp"
                android:layout_height="@dimen/margin_40dp"
                android:src="@drawable/ic_pause_circle_outline_black_24dp"/>
            <ImageView
                android:visibility="gone"
                android:layout_gravity="center"
                android:id="@+id/play"
                android:layout_width="@dimen/margin_40dp"
                android:layout_height="@dimen/margin_40dp"
                android:src="@drawable/ic_play_circle_outline_black_24dp"/>

        </FrameLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:visibility="gone"
        android:id="@+id/layout"
        android:layout_centerInParent="true"
        android:elevation="@dimen/padding_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    <ProgressBar
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progress_bar"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/popinbold"
            android:text="@string/loading"
            android:textColor="@color/pink"
            android:gravity="center"
            android:layout_marginTop="@dimen/padding_5"/>
    </LinearLayout>
</RelativeLayout>
