<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".activities.ContactUsActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@color/light_white"
            android:paddingBottom="@dimen/margin_20dp"
            android:paddingTop="@dimen/margin_10dp"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_marginTop="@dimen/margin_15"
                android:id="@+id/back"
                android:layout_marginStart="@dimen/margin_15"
                android:layout_width="@dimen/margin_20dp"
                android:layout_height="@dimen/margin_20dp"
                android:src="@drawable/back"
                tools:ignore="RtlCompat" />
            <TextView
                android:textSize="@dimen/text_17sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/contact_us"
                android:textColor="@color/pink"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_10dp"
                android:fontFamily="@font/popinbold"/>
            <ImageView
                android:layout_marginTop="@dimen/text_30sp"
                android:layout_marginBottom="@dimen/margin_20dp"
                android:layout_below="@id/back"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/customer_care"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_below="@+id/header"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_gravity="center"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feel_free_to_connect_us_for_any_query"
                    android:textColor="@color/pink"
                    android:gravity="center"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:fontFamily="@font/popinbold"/>
                <androidx.cardview.widget.CardView
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:layout_marginStart="@dimen/margin_15"
                    android:layout_marginEnd="@dimen/margin_15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/margin_10dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:elevation="@dimen/padding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/helpEmail"
                            android:layout_marginTop="@dimen/margin_20dp"
                            android:textColor="@color/pink"
                            android:textSize="@dimen/text_13sp"
                            android:fontFamily="@font/popinbold"
                            android:layout_marginStart="@dimen/margin_10dp"
                            android:layout_marginEnd="@dimen/margin_10dp"
                            android:layout_below="@+id/txt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:text="Email:support@gunjan.app"/>
                        <ImageView
                            android:layout_marginTop="@dimen/margin_10dp"
                            android:layout_gravity="center"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/call"/>
                        <TextView
                            android:id="@+id/helpNumber"
                            android:layout_marginBottom="@dimen/margin_20dp"
                            android:layout_marginTop="@dimen/margin_10dp"
                            android:textColor="@color/pink"
                            android:textSize="@dimen/text_13sp"
                            android:fontFamily="@font/popinbold"
                            android:layout_marginStart="@dimen/margin_10dp"
                            android:layout_marginEnd="@dimen/margin_10dp"
                            android:layout_below="@+id/txt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:text="Call Us:"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_marginBottom="@dimen/margin_20dp"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:textColor="@color/txt_color"
                    android:textSize="14sp"
                    android:fontFamily="@font/popinbold"
                    android:layout_marginStart="@dimen/margin_10dp"
                    android:layout_marginEnd="@dimen/margin_10dp"
                    android:layout_below="@+id/txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:text="@string/or"/>
                <androidx.cardview.widget.CardView
                    android:elevation="@dimen/padding_3"
                    android:layout_marginStart="@dimen/margin_15"
                    android:layout_marginEnd="@dimen/margin_15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/text_30sp"
                    app:cardBackgroundColor="@color/white">
                    <EditText
                        android:layout_gravity="center"
                        android:id="@+id/subject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="@string/your_subject"
                        android:maxLines="1"
                        android:maxLength="30"
                        android:inputType="text"
                        android:layout_marginStart="7dp"
                        android:padding="@dimen/margin_15"
                        android:fontFamily="@font/poppin_regular"
                        android:textColor="@color/txt_color"
                        android:textColorHint="@color/txt_color"
                        android:textSize="@dimen/text_13sp"
                        tools:ignore="RtlCompat" />
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/card"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:layout_marginStart="@dimen/margin_15"
                    android:layout_marginEnd="@dimen/margin_15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/margin_10dp"
                    app:cardBackgroundColor="@color/white">
                    <EditText
                        android:layout_gravity="top"
                        android:gravity="top"
                        android:id="@+id/query"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:background="@null"
                        android:hint="@string/write_your_query"
                        android:maxLength="150"
                        android:inputType="textMultiLine"
                        android:layout_marginStart="7dp"
                        android:padding="@dimen/margin_15"
                        android:fontFamily="@font/poppin_regular"
                        android:textColor="@color/txt_color"
                        android:textColorHint="@color/txt_color"
                        android:textSize="@dimen/text_13sp"
                        tools:ignore="RtlCompat" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:id="@+id/Submit"
                    android:elevation="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/text_30sp"
                    android:layout_marginTop="60dp"
                    android:layout_marginEnd="@dimen/text_30sp"
                    android:layout_marginBottom="@dimen/margin_25"
                    android:background="@drawable/button_bg"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_5">
                    <TextView
                        android:layout_marginTop="@dimen/padding_5"
                        android:layout_marginBottom="@dimen/padding_5"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textSize="@dimen/text_18sp"
                        android:fontFamily="@font/popinbold"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/submit"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>