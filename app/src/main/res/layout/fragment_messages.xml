<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.ActiveMembersFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <RelativeLayout
         android:visibility="gone"
        android:id="@+id/group_layout"
        android:paddingStart="@dimen/margin_10dp"
        android:paddingEnd="@dimen/margin_10dp"
        android:paddingTop="@dimen/margin_20dp"
        android:paddingBottom="@dimen/margin_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/padding_3"
        android:layout_marginStart="@dimen/margin_10dp"
        android:layout_marginEnd="@dimen/margin_10dp"
        android:layout_marginTop="@dimen/padding_5"
        android:layout_marginBottom="@dimen/padding_5"
        android:background="@drawable/circle_pinkborder">
        <TextView
            android:layout_marginEnd="@dimen/margin_10dp"
            android:layout_marginStart="@dimen/margin_10dp"
            android:layout_centerInParent="true"
            android:gravity="start"
            android:id="@+id/message_time"
            android:layout_gravity="center"
            android:layout_alignParentEnd="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_light"
            android:textSize="@dimen/text_size_11"
            android:textColor="#4B4B4B"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_marginStart="@dimen/margin_10dp"
                android:layout_gravity="center"
                android:gravity="top"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/group_pic"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:src="@drawable/user_avatar"/>
            </LinearLayout>
            <LinearLayout
                android:layout_weight="1"
                android:layout_marginTop="@dimen/padding_5"
                android:layout_marginStart="@dimen/margin_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_marginStart="@dimen/padding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="@dimen/margin_15"
                    android:textColor="@color/black2"
                    android:id="@+id/group_name"/>
                <LinearLayout
                    android:layout_marginStart="@dimen/padding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:gravity="start"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/padding_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppin_medium"
                        android:textSize="@dimen/text_12sp"
                        android:textColor="@color/txt_color"
                        android:id="@+id/group_message"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_gravity="center"
                android:text="@string/community"
                android:layout_marginStart="@dimen/padding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/margin_15"
                android:textColor="@color/pink"/>
        </LinearLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="@dimen/margin_10dp"
        android:layout_marginBottom="63dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:id="@+id/members_recycler"/>
    </LinearLayout>
    <TextView
        android:visibility="gone"
        android:text="@string/no_community"
        android:textColor="@color/pink"
        android:textSize="@dimen/margin_25"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:scaleType="fitXY"
        android:fontFamily="@font/popinbold"
        android:id="@+id/blank_data"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_launcher_background"/>
</RelativeLayout>