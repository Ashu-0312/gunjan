<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingStart="@dimen/margin_10dp"
    android:paddingEnd="@dimen/margin_10dp"
    android:paddingTop="@dimen/margin_15"
    android:paddingBottom="@dimen/margin_15"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/padding_3"
    android:layout_marginStart="@dimen/margin_10dp"
    android:layout_marginEnd="@dimen/margin_10dp"
    android:layout_marginTop="@dimen/padding_5"
    android:layout_marginBottom="@dimen/padding_5"
    android:background="@drawable/circle_white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_gravity="center"
            android:gravity="top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <de.hdodenhof.circleimageview.CircleImageView
                android:elevation="@dimen/padding_2"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/user_avatar"
                android:id="@+id/pic"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/padding_5"
            android:layout_marginStart="@dimen/margin_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_marginStart="@dimen/padding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/popinbold"
                android:textSize="@dimen/text_16sp"
                android:textColor="#2C2A2A"
                android:id="@+id/title"/>
            <LinearLayout
                android:layout_marginStart="@dimen/padding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:gravity="start"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/padding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppin_medium"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="#4B4B4B"
                    android:id="@+id/about"/>

            </LinearLayout>


            <LinearLayout
                android:layout_marginTop="@dimen/margin_10dp"
                android:gravity="end"
                android:elevation="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="@drawable/button_bg"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/status"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:layout_marginTop="@dimen/margin_7"
                    android:layout_marginBottom="@dimen/margin_7"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/text_13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>