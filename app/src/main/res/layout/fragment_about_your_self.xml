<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_below="@+id/header">
            <ImageView
                android:layout_marginTop="@dimen/margin_20dp"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:src="@drawable/logo"/>
            <TextView
                android:id="@+id/txt"
                android:gravity="center"
                android:layout_below="@id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppin_regular"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_13sp"
                android:layout_marginTop="@dimen/margin_40dp"
                android:layout_marginStart="@dimen/text_30sp"
                android:layout_marginEnd="@dimen/text_30sp"
                android:text="@string/tell_us_about_yourself"/>
            <LinearLayout
                android:elevation="2dp"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_25"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="@dimen/margin_25"
                android:layout_marginBottom="@dimen/padding_5"
                android:background="@drawable/pink_border"
                android:orientation="horizontal">
                <androidx.cardview.widget.CardView
                    android:id="@+id/card"
                    android:layout_margin="1dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/margin_15"
                    app:cardBackgroundColor="@color/white">
                    <EditText
                        android:layout_gravity="top"
                        android:gravity="top"
                        android:id="@+id/about"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/write_here"
                        android:maxLength="500"
                        android:inputType="textMultiLine"
                        android:layout_marginStart="7dp"
                        android:padding="@dimen/padding_5"
                        android:fontFamily="@font/poppin_regular"
                        android:textColor="@color/txt_color"
                        android:textColorHint="@color/txt_color"
                        android:textSize="@dimen/text_13sp"
                        tools:ignore="RtlCompat" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <TextView
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/text_30sp"
                android:layout_marginStart="@dimen/margin_25"
                android:gravity="end"
                android:id="@+id/text_count"
                android:layout_marginTop="@dimen/padding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500 char. max."
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_12sp"/>
            <LinearLayout
                android:id="@+id/Continue"
                android:elevation="1dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_40dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="@dimen/margin_40dp"
                android:layout_marginBottom="@dimen/padding_5"
                android:background="@drawable/button_bg"
                android:orientation="horizontal"
                android:padding="@dimen/padding_5">
                <TextView
                    android:layout_marginTop="@dimen/padding_5"
                    android:layout_marginBottom="@dimen/padding_5"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/text_18sp"
                    android:fontFamily="@font/popinbold"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_txt"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>