<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_7"
    android:layout_marginBottom="@dimen/margin_7"
    android:layout_marginStart="@dimen/padding_2"
    android:layout_marginEnd="@dimen/padding_2"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:elevation="@dimen/padding_5"
    app:cardCornerRadius="@dimen/margin_10dp">
    <LinearLayout
        android:layout_margin="@dimen/margin_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/lefLayout"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:text="Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppin_medium"
                    android:textSize="14sp"
                    android:textColor="@color/black2"
                    android:id="@+id/question"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/show_details"
                android:layout_marginEnd="@dimen/margin_15"
                android:layout_gravity="center"
                android:layout_width="@dimen/margin_15"
                android:layout_height="@dimen/margin_15"
                android:src="@drawable/red_drop_down"/>
        </LinearLayout>
        <TextView
            android:text="description"
            android:layout_marginTop="@dimen/padding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppin_regular"
            android:textSize="@dimen/text_12sp"
            android:textColor="@color/txt_color"
            android:id="@+id/answer"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>