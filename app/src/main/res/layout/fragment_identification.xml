<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/header"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_20dp"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/header"
                android:layout_marginStart="@dimen/text_30sp"
                android:layout_marginTop="@dimen/margin_40dp"
                android:layout_marginEnd="@dimen/text_30sp"
                android:fontFamily="@font/poppin_regular"
                android:gravity="center"
                android:text="Upload photo for"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/header"
                android:layout_marginStart="@dimen/text_30sp"
                android:layout_marginEnd="@dimen/text_30sp"
                android:fontFamily="@font/poppin_regular"
                android:gravity="center"
                android:text="@string/identification"
                android:textColor="@color/txt_color"
                android:textSize="@dimen/text_13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_25"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="@dimen/margin_25"
                android:layout_marginBottom="@dimen/padding_5"
                android:background="@drawable/pink_border"
                android:elevation="2dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/choosePic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    app:cardCornerRadius="@dimen/margin_15">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">
                        <androidx.cardview.widget.CardView
                            android:visibility="gone"
                            android:id="@+id/layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:id="@+id/identityPic"
                                android:src="@drawable/user_avatar"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout
                            android:id="@+id/layout2"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_gravity="center">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:src="@drawable/user_avatar"
                                app:civ_border_color="@color/pink"
                                app:civ_border_width="@dimen/padding_2" />

                            <ImageView
                                android:layout_width="@dimen/margin_25"
                                android:layout_height="@dimen/margin_25"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="65dp"
                                android:src="@drawable/add" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Photo Verification"
                            android:textColor="@color/pink"
                            android:textSize="@dimen/text_12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/profilePic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/user_avatar"
                        android:visibility="gone" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/AddPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_40dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="@dimen/margin_40dp"
                android:layout_marginBottom="@dimen/padding_5"
                android:background="@drawable/button_bg"
                android:elevation="1dp"
                android:orientation="horizontal"
                android:padding="@dimen/padding_5">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/padding_5"
                    android:layout_marginBottom="@dimen/padding_5"
                    android:fontFamily="@font/popinbold"
                    android:gravity="center"
                    android:text="@string/add_photo"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_18sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>